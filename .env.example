# Copy this to .env and fill in your values.
# These variables are referenced in docker-compose.yml and YAML config files.

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CONFIG_DIR=/config
APP_DATA_DIR=/data

# Site label shown in browser tab title and email subjects
SITE_NAME=

# InfluxDB
INFLUXDB_TOKEN=
INFLUXDB_ADMIN_PASSWORD=

# OPC UA server credentials (if using username auth)
PLC_PASSWORD=

# SMTP email (all fields optional — can also be configured in the Settings UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Multiple recipients: comma-separated
SMTP_TO=operator@example.com,manager@example.com

# IXON SecureEdge Pro
# EDGE_IP=192.168.140.1
